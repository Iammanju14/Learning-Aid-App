<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="activityheader">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:textColor">@color/status</item>
        <item name="android:textSize">@dimen/headerTextSize</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>


    <style name="listcontent">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/listTextSize</item>
    </style>

    <style name="activityheaderlabel">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textColor">@color/teal_700</item>
        <item name="android:textSize">@dimen/listTextSize</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="activitylabel">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/listTextSize</item>
    </style>

    <style name="activityButton" >
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:background">@color/blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>